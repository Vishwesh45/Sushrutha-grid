# Copy to backend/.env for local; set the same keys in Render → Environment

HOST=0.0.0.0
PORT=8000

# MongoDB Atlas connection string (not localhost in production)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=sushrutha_grid

# Use a long random secret in production (never reuse the default)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# After Vercel deploy, set to your exact frontend origin(s), comma-separated
# Example: https://sushrutha-grid.vercel.app
# Use * only for first smoke test
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail SMTP (App Password) — password reset + follow-up emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sushrutha Grid Hospital Platform

# Optional Ask AI LLM (leave empty / provider=off for rules-only)
PATIENT_LLM_PROVIDER=off
PATIENT_LLM_MODEL=
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
